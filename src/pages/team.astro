---
import Layout from "../layouts/Layout.astro";
import {Image} from "astro:assets";
import EmImg from "../assets/images/em-img.jpg"
import VKImg from "../assets/images/vk-img.png"

---
<Layout>
    <section class="team-section">
        <div class="team-container">
            <div class="title-container">
                <h1 class="main-title">Meet the Team</h1>
            </div>
            <div class="intro-container">
                <div class="intro-card intro-em">
                    <div class="image-container">
                        <Image/
                            src={EmImg}
                            alt="Portrait cofounder Emily"
                        >
                    </div>
                    <div class="description-container intro-em">
                        <h2>Emily Yang</h2>
                        <p>
                            Brand Strategist & <br> Creative Director
                        </p>
                    </div>
                </div>
                <div class="intro-card intro-vk">
                    <div class="image-container">
                        <Image/
                            src={VKImg}
                            alt="Portrait cofounder Vladys"
                        >
                    </div>
                    <div class="description-container">
                        <h2>Vladys Kolodnytskyy</h2>
                        <p>
                            Shopify Developer & <br> 
                            Creative Technologist
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
.team-section{
    .team-container{
        padding: 30px 20px;
        .title-container{
            h1{
                font-weight: 700;
            }
        }
        .intro-container{
            margin-top:60px;
            .intro-card{
                display: flex;
                .image-container{
                    width: 114px;
                    height: 183px;
                    img{
                        width: 114px;
                        height: 100%;
                        object-fit: cover;
                        object-position: top;
                    }
                }
                .description-container{
                    padding:30px 0 10px 20px;
                    display: flex;
                    flex-direction: column;
                    justify-content: end;
                    h2{
                        margin-bottom: 5px;
                        font-size: 15px;
                    }
                    p{
                        font-size: 12px;
                    }
                }

            }
            .intro-vk,
            .intro-marshall{
                border-top:1px solid black;
                padding-top: 20px;
                padding-bottom: 20px;
            }
            .intro-em{
                padding-bottom: 20px;
            }
        }

    }
}

@media (min-width:768px){
    .team-section{
        .team-container{
            display: flex;
            padding: 50px 45px;
            
            .title-container{
                width: 40%;
            }
            .intro-container{
                width: 60%;
                margin:0;
                .intro-card{
                    .image-container{
                        width: 173px;
                        height: 256px;
                        img{
                            width: 173px;
                            height: 256px;
                        }
                    }
                    .description-container{
                        h2{
                            font-size: 22px;
                        }
                        p{
                            font-size: 16px;
                        }                    
                    }                    
                }

            }
        }
    }
}
@media (min-width:1200px){
    .team-section{
        .team-container{   
            .title-container{
                h1{
                    font-size: 47px;
                }
            }
        }
    }
}

</style>
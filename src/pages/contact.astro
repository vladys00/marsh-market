---
import Layout from '../layouts/Layout.astro';
import {Image} from "astro:assets";
import EgretImage from "../assets/images/contact-page.webp"
---
<Layout>
    <section class="contact-section">
        <div class="contact-container">
            <div class="image-container">
                <Image
                    src={EgretImage}
                    alt="egret flying"
                />
            </div>  
            <div class="text-container">
                <div class="title-container">
                    <h1 class="main-title">Contact</h1>
                </div>
                <div class="links-container">
                    <div class="contact-info">
                        <p>+34 655 066 245</p>
                        <p><a href="mailto:hola@marshmarket.es">hola@marshmarket.es</a></p>
                    </div>
                    <div class="social-links">
                        <!-- <a href="https://www.instagram.com/marshmarket_/">Instagram</a> -->
                        <a href="https://www.linkedin.com/company/marsh-market/">LinkedIn</a>
                    </div>
                </div>
            </div>
        </div>

    </section>

</Layout>

<style>
.contact-section{
    .contact-container{
        display: flex;
        flex-direction: column-reverse;
        .image-container{
            width: 100vw;
            height: 550px;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: -230px;

            }
        }
        .text-container{
            padding: 30px 20px;
            .title-container{
                h1{
                    font-weight: 700;
                    margin-bottom: 50px;
                }
            }
            .links-container{
                padding: 20px 0 0 0;
                text-align: right;
                .contact-info,
                .social-links{
                    font-size: 20px;
                }
                .social-links{
                    margin-top: 20px;
                }
                a{
                    all:unset;
                    display: block;
                }
                a:hover{
                    cursor: pointer;
                }
            }

        }
    }
}
@media (min-width:400px){
.contact-section{
    .contact-container{
        .image-container{

            img{
                object-position: center;

            }
        }

    }
}
}

@media (min-width:768px){
    .contact-section{
        padding: 80px 45px;
        .contact-container{
            flex-direction: row-reverse;
            .image-container{
                width:65%;
                height: 80vh;
                max-height: 900px;
            }
            .text-container{
                padding: 0;
                width: 35%;
                display: flex;
                flex-direction: column;
                align-items:start;
                .title-container{
                    h1{
                        text-align: end;
                        margin: 0;
                    }
                }
                .links-container{
                    text-align: start;
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    .social-links{
                        margin-top: 0;
                    }
                }
            }

        }
    }
}

@media (min-width:900px){
    .contact-section{
        padding: 100px 65px;
    }
}

@media (min-width:950px){
    .contact-section{
        .contact-container{
            .image-container{
                width:65%;
                height: 80vh;
            }
            .text-container{
                width: 35%;
            }
        }
    }
}


</style>
---
import Layout from '../layouts/Layout.astro';
import {Image} from "astro:assets";
import EgretImage from "../assets/images/contact-page.png"
---
<Layout>
    <section class="contact-section">
        <div class="contact-container">
            <div class="image-container">
                <Image
                    src={EgretImage}
                    alt="egret flying"
                />
            </div>  
            <div class="text-container">
                <div class="title-container">
                    <h1>Contact</h1>
                </div>
                <div class="links-container">
                    <div>
                        <p>+34 655 066 245</p>
                        <p>vldk0022@gmail.com</p>
                    </div>
                    <div>
                        <a href="https://www.instagram.com/marshmarket_/">Instagram</a>
                        <a href="https://www.instagram.com/marshmarket_/">LinkedIn</a>
                    </div>
                    


                </div>
            </div>
        </div>

    </section>

</Layout>

<style>
.contact-section{
    .contact-container{
        display: flex;
        flex-direction: column-reverse;
        .image-container{
            width: 100vw;
            height: 550px;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: -275px;

            }
        }
        .text-container{
            padding: 30px 20px;
            .title-container{
                h1{
                    font-weight: 700;
                    font-size: 35px;
                    margin-bottom: 50px;
                }
            }
            .links-container{
                padding: 20px 0;
                text-align: right;
                text-transform: uppercase;
                a{
                    all:unset;
                    display: block;
                }
                a:hover{
                    cursor: pointer;
                }
            }
            .links-container a:first-of-type{
                margin-top:20px;
            }
        }
    }
}
@media (min-width:400px){
.contact-section{
    .contact-container{
        .image-container{

            img{
                object-position: center;

            }
        }

    }
}
}

@media (min-width:768px){
    .contact-section{
        padding: 50px 45px;
        .contact-container{
            flex-direction: row-reverse;
            .image-container{
                width:65%;
                height: 80vh;
                max-height: 900px;
            }
            .text-container{
                padding: 0 0 0 30px;
                width: 35%;
                display: flex;
                flex-direction: column;
                align-items:start;
                .title-container{
                    h1{
                        text-align: end;
                        margin: 0;
                    }
                }
                .links-container{
                    text-align: start;
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                }
            }

        }
    }
}

@media (min-width:950px){
    .contact-section{
        .contact-container{
            .image-container{
                width:65%;
                height: 80vh;
            }
            .text-container{
                width: 35%;
            }
        }
    }
}

@media (min-width:1200px){
    .contact-section{
        .contact-container{
            .text-container{
                .title-container{
                    h1{

                        font-size: 47px;

                    }
                }

            }

        }
    }
}
</style>
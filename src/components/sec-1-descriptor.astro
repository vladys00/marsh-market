---
import {Image} from "astro:assets";
import SliderImg1 from "../assets/slider-images/emi-photo.png";
---

<section class="sec-1-descriptor">
    <div class="test-width">
        <div class="sec-main-desc-cont ">
            <div class="desc-cont">
                <h2>
                    We shape <br> iconic identities that perform <br class="desktop-break">—  
                    in culture and numbers.
                </h2>
                <p class="main-text">
                    Hola! Welcome to Marsh Market — a complete Shopify world for brands that never settle for less. We work inside the ecosystem — strategy, build, creativity, and performance — so nothing gets lost in translation.
                </p>
                
                <a class="contact-button" href="/contact">
                    Let`s talk
                </a>
                
            </div>
            <div class="img-container">
                <Image
                    src={SliderImg1}
                    alt="girl photoshoot image studio "
                />
            </div>
    
        </div>

    </div>
</section>

<style>
.sec-1-descriptor{
    width: 100%;
    .sec-main-desc-cont{
        
        .desc-cont{
            width: 100%;
            padding: 28% 20px 30px 20px;
            max-width: 750px;
            h2{
                font-size: 35px;
                width: 80%;
                line-height: 1.3;
                .desktop-break{
                    display: none;
                }
            }
            .main-text{
                margin:20px 0;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-1-descriptor{
        max-height: 850px;
        height: fit-content;
        position: relative;
        .sec-main-desc-cont{
            padding:50px 45px;
            height: 100%;
            position: relative;
            display:flex;
            gap:0px;
            justify-content: space-between;

            .desc-cont{
                padding: 0 50px 50px 0;
                width: 60%;
                display: flex;
                flex-direction: column;
                justify-content: end;
                h2{
                    font-size: 30px;
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }
                .main-text {
                    margin: 34px 0;
                }
                .contact-button{
                    width: fit-content;
                }
            }
            .img-container{
                position: relative;
                height: 100%;
                width: 40%;
                max-width:600px;
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: fill;
                }
            }
        }
    }
}
@media (min-width:900px){
    .sec-1-descriptor{

        .sec-main-desc-cont{

            .desc-cont{

                h2{
                    font-size: 35px;

                }

            }
        }
    }
}
@media (min-width:1200px){
    .sec-1-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                h2{
                    font-size: 47px;
                }
            }
        }
    }
}
</style>
---
import {Image} from "astro:assets";
import SliderImg1 from "../assets/slider-images/slider-1.webp";
import SliderImg2 from "../assets/slider-images/slider-3.png";
import SliderImg3 from "../assets/slider-images/slider-5.png";
import SliderImg4 from "../assets/slider-images/sand.jpg";
---

<section class="sec-1-descriptor">
    <div class="sec-main-desc-cont sec-main-padding">
        <div class="desc-cont">
            <h1 class="main-title">
                Dare to stay true.
            </h1>
            <div class="main-text">
                <p>
                    A strategic consultancy that feels 
                </p>
                <p>
                    like a paradise. Marsh Market drives
                </p>
                <p>
                    sustainable growth for businesses 
                </p>
                <p>
                    rooted in purpose and soul.   
                </p>
            </div>
            
            
            
        </div>
        <div class="img-container">
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg1}
                        alt="model photo artsy blue"
                    >
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg2}
                        alt="buterfly wings texture"
                    >
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg3}
                        alt="white flowers artsy photoshoot"
                    >                                     
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg4}
                        alt="lock of hair on white backgorund artsy picture"
                    > 
                </div>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
.sec-1-descriptor{
    width: 100%;
    .sec-main-desc-cont{
        .desc-cont{
            padding: 30px 20px 50px 20px;
            max-width: 750px;
            display:grid;
            gap:20px;
            h2{
                font-weight: 700;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            .swiper {
                width: 100%;
                height: 100%;
            }

            .swiper-slide img {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-1-descriptor{
        height: fit-content;
        position: relative;
        .sec-main-desc-cont{
            padding-top:50px;
            position: relative;
            display:flex;
            gap:0px;
            justify-content: space-between;

            .desc-cont{
                padding: 80px 0 0 0;
                width: 60%;
                display: flex;
                flex-direction: column;
                h2{
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }

            }
            .img-container{
                position: relative;
                height: 100%;
                aspect-ratio: 490/600;
                max-height: 430px;
                max-width: 320px; 
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: fill;
                }
            }
        }
    }
}
@media (min-width:1200px){
    .sec-1-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                padding: 140px 0 0 0;
                .main-text {
                    margin: 45px 0 0 0;
                }
            }
            .img-container{
                max-height: 600px;
                max-width: 490px; 
            }
        }
    }
}
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay } from "swiper/modules";

    import "swiper/css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";

    console.log("javascript working");

     let swiper = new Swiper(".mySwiper", {
        modules: [Autoplay],
        loop: true,
        autoplay: {
        delay: 2500,       
        disableOnInteraction: false
        },
     });
</script>
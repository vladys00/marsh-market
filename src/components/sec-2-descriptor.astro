---
import { Image } from "astro:assets";
import egretImage from "../assets/images/sec2.png";
---

<section class="sec-2-descriptor center-content">
    <div class="sec-main-desc-cont page-width">
        <div class="desc-cont">
            <h2>
                We connect <br>
                brand, Shopify, and creativity to<br class="desktop-break"> build more authentic commerce.    
            </h2>
            <p class="main-text">
                Building a commerce brand is complex — especially when growth accelerates faster than your systems can keep up.You look for help, but quickly realize the problem:
                Design studios speak art, but not business.
                Shopify agencies think in features, but not feelings.
                Creative consultancies breathe culture, but not numbers.
                Oops. You can’t have it all, can you?
            </p>
            <p>
                <span class="bold-text">Not until Marsh Market. </span> 
                A studio built on the belief that growth shouldn’t require compromise. We bring brand expertise, strategic clarity, technical reliability, and cultural fluency into one integrated practice — working with brand-first businesses that have purpose and soul.
                Hop on our boat — we’ll show you where meaning meets momentum.
            </p>
            
            
        </div>
        <div class="img-container">
            <Image
            src={egretImage}
            alt="Description of image"
            width={600}
            height={400}
            />
        </div>

    </div>
</section>

<style>
.sec-2-descriptor{
    width: 100vw;
    .sec-main-desc-cont{
        .desc-cont{
            width: 100%;
            padding: 28% 20px 30px 20px;
            h2{
                font-size: 35px;
                width: 80%;
                line-height: 1.3;
                .desktop-break{
                    display: none;
                }
            }
            .main-text{
                margin:20px 0;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-2-descriptor{
        max-height: 850px;
        height: 90vh;
        position: relative;
        .sec-main-desc-cont{
            padding:50px 45px;
            height: 100%;
            position: relative;
            display:flex;
            flex-direction: row-reverse;
            gap:50px;
            justify-content: space-between;

            .desc-cont{
                padding: 0 0 50px 0;
                width: 70%;
                max-width: 750px;
                display: flex;
                flex-direction: column;
                justify-content: end;
                h2{
                    font-size: 35px;
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }
                .main-text {
                    margin: 34px 0;
                }
                .contact-button{
                    width: fit-content;
                }
            }
            .img-container{
                position: relative;
                height: 100%;
                width: 514px;
                max-height: none;
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
            }
        }
    }
}

@media (min-width:1200px){
    .sec-2-descriptor{
        .sec-main-desc-cont{
            gap:80px;
            .desc-cont{
                h2{
                    font-size: 47px;
                }
            }
        }
    }
}
</style>
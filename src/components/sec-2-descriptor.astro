---
import { Image } from "astro:assets";
import egretImage from "../assets/images/egret-sec-2.png";
---

<section class="sec-2-descriptor ">
    <div class="sec-main-desc-cont ">
        <div class="desc-cont">
            <h2 class="main-title">
                We connect brand, <br>Shopify, and creativity<br> to build more authentic<br> commerce.    
            </h2>
            <p class="main-text text-top">
            Unlike the average Shopify dev shop or traditional design agency, we speak commerce, art, code, numbers, and culture—like it’s second nature.
            </p>
            <p class="bottom-paragraph main-text"> 
                We believe growth shouldn’t require compromise. That’s why we unite brand expertise, strategic clarity, technical reliability, and cultural fluency into one integrated practice, partnering with brand-first businesses driven by purpose and soul.
            </p>
            
            
        </div>
        <div class="img-container">
            <Image
            src={egretImage}
            alt="Description of image"
            width={600}
            height={400}
            />
        </div>

    </div>
</section>

<style>

.sec-2-descriptor{
    width: 100%;
    .sec-main-desc-cont{
        .desc-cont{
            width: 100%;
            padding: 28% 20px 30px 20px;
            h2{
                width: 100%;
                .desktop-break{
                    display: none;
                }
            }
            .text-top{
                margin:20px 0;
            }
            .bottom-paragraph{
                margin-bottom:20px;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-2-descriptor{
        position: relative;
        .sec-main-desc-cont{
            padding:100px 45px 50px;
            height: 100%;
            position: relative;
            display:flex;
            flex-direction: row-reverse;
            gap:30px;
            justify-content: space-between;
            align-items: end;

            .desc-cont{
                padding: 0;
                width: 60%;
                max-width: 475px;
                display: flex;
                flex-direction: column;
                justify-content: end;
                h2{
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }
                .text-top {
                    margin: 35px 0 20px 0;
                } 
                .bottom-paragraph{
                    margin:0;
                }
                .contact-button{
                    width: fit-content;
                }
            }
            .img-container{
                position: relative;
                aspect-ratio: 490/655;
                width: 320px; 
                height: 485px;
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
            }

        }
    }
}
@media (min-width:500px) and (max-width:768px){
    .sec-2-descriptor{
        .sec-main-desc-cont{
            .img-container{
                img{
                    object-position: center 21%;
                }
            }
        }
    }
}
@media (min-width:1200px){
    .sec-2-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                max-width: 580px;
            }
            .img-container{
                width: 490px;
                height: 655px;
            }
        }
    }
}
</style>
---
import { Image } from "astro:assets";
import egretImage from "../assets/images/babies.png";
---

<section class="sec-2-descriptor">
    <div class="sec-main-desc-cont sec-main-padding">
        <div class="desc-cont">
            <h2 class="main-title">
                Build a more <br>authentic world <br> with us.
            </h2>
            <p class="main-text text-top">
            With total cross-disciplinary fluidity,<br>
            we architect bespoke 360º ecosystems<br>
            that nurture your essence while<br>
            multiplying impact.
            </p>
           
            
            
        </div>
        <div class="img-container">
            <Image
            src={egretImage}
            alt="Description of image"
            width={1200}
            height={799}
            />
        </div>

    </div>
</section>

<style>

.sec-2-descriptor{
    .desc-cont{
        padding: 30px 20px 50px 20px;
        display:grid;
        gap:20px;
    }
    .img-container{
        img{
            width:100%;
            height:100%;
            display:block;
        }
    }
}

@media (width > 768px){      
    .sec-2-descriptor{
        .sec-main-desc-cont{
            display: grid;
            grid-template-columns: 1fr 1fr;
            .desc-cont{
                padding:30px 0 0 0;
                gap:0;
                order:2;
                justify-self: end;
                max-height: 275px;
            }

        }

    }
}
@media (width > 1200px){      
    .sec-2-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                width: 490px;
                max-height: none;
            }

        }

    }
}
</style>
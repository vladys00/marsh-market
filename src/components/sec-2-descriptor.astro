---
import { Image } from "astro:assets";
import egretImage from "../assets/images/egret-sec2.webp";
---

<section class="sec-2-descriptor ">
    <div class="sec-main-desc-cont ">
        <div class="desc-cont">
            <h2>
                We connect <br>
                brand, Shopify, and creativity to build more authentic commerce.    
            </h2>
            <p class="main-text">
            Unlike the average Shopify dev shop or traditional design agency, <span class="bold">we speak commerce, art, code, numbers, and culture—like it’s second nature.</span>
            </p>
            <p class="bottom-paragraph"> 
                We believe growth shouldn’t require compromise. That’s why we unite brand expertise, strategic clarity, technical reliability, and cultural fluency into one integrated practice, <span class="bold">partnering with brand-first businesses driven by purpose and soul.</span> 
            </p>
            
            
        </div>
        <div class="img-container">
            <Image
            src={egretImage}
            alt="Description of image"
            width={600}
            height={400}
            />
        </div>

    </div>
</section>

<style>
.sec-2-descriptor{
    width: 100%;
    .sec-main-desc-cont{
        .desc-cont{
            width: 100%;
            padding: 28% 20px 30px 20px;
            h2{
                font-size: 35px;
                width: 80%;
                line-height: 1.3;
                .desktop-break{
                    display: none;
                }
            }
            .main-text{
                margin:20px 0;
            }
            .bottom-paragraph{
                margin-bottom:20px;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            img{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-2-descriptor{
        max-height: 850px;
        height: 90vh;
        position: relative;
        .sec-main-desc-cont{
            padding:50px 45px;
            height: 100%;
            position: relative;
            display:flex;
            flex-direction: row-reverse;
            gap:0px;
            justify-content: space-between;

            .desc-cont{
                padding: 0 0 50px 50px;
                width: 60%;
                max-width: 750px;
                display: flex;
                flex-direction: column;
                justify-content: end;
                h2{
                    font-size: 35px;
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }
                .main-text {
                    margin: 34px 0;
                }
                .contact-button{
                    width: fit-content;
                }
                .bottom-paragraph{
                    margin-bottom:34px;
                }
            }
            .img-container{
                position: relative;
                height: 100%;
                width: 60%;
                max-width: 500px;
                max-height: none;
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
            }

        }
    }
}

@media (min-width:1200px){
    .sec-2-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                h2{
                    font-size: 47px;
                }
            }
        }
    }
}
</style>
---
import {Image} from "astro:assets";
import SliderImg1 from "../assets/slider-images/slider-2.png";
import SliderImg2 from "../assets/slider-test-images/water-blue.png";
import SliderImg3 from "../assets/slider-test-images/water-gold.png";
import SliderImg4 from "../assets/slider-test-images/water-sun.png";
---

<section class="sec-1-descriptor">
    <div class="sec-main-desc-cont ">
        <div class="desc-cont">
            <h2>
                Shh... <br> It's a hidden paradise for brands that dare to stay true. <br>
                Meet the team
            </h2>
            <p class="main-text">
                Hola ! Welcome to Marsh Market. We're an independent, brand-first Shopify growth studio based in Madrid, Spain. Encantados !
            </p>
            
            
        </div>
        <div class="img-container">
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg2}
                        alt="egret flying"
                    >
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg3}
                        alt="buterfly wings texture"
                    >
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg1}
                        alt="white flowers artsy photoshoot"
                    >                                     
                </div>
                <div class="swiper-slide">
                    <Image/
                        src={SliderImg4}
                        alt="lock of hair on white backgorund artsy picture"
                    > 
                </div>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
.sec-1-descriptor{
    width: 100%;
    .sec-main-desc-cont{
        
        .desc-cont{
            width: 100%;
            padding: 28% 20px 30px 20px;
            max-width: 750px;
            h2{
                font-size: 35px;
                width: 80%;
                line-height: 1.3;
                .desktop-break{
                    display: none;
                }
            }
            .main-text{
                margin:20px 0;
            }

        }
        .img-container{
            position: relative;
            height: 540px;
            width: 100%;
            .swiper {
                width: 100%;
                height: 100%;
            }

            .swiper-slide img {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }
}

@media (min-width:768px){
    .sec-1-descriptor{
        height: calc(100vh - 90px);
        position: relative;
        max-height: 850px;
        .sec-main-desc-cont{
            padding:50px 45px;
            height: 100%;
            position: relative;
            display:flex;
            gap:0px;
            justify-content: space-between;

            .desc-cont{
                padding: 0 50px 50px 0;
                width: 60%;
                display: flex;
                flex-direction: column;
                justify-content: end;
                h2{
                    font-size: 30px;
                    width: 100%;
                    .desktop-break{
                        display: block;
                    }
                }
                .main-text {
                    margin: 34px 0;
                }
                .contact-button{
                    width: fit-content;
                }
            }
            .img-container{
                position: relative;
                height: 100%;
                width: 40%;
                max-width:500px;
                img{
                    width: 100%;
                    height: 100%;
                    object-fit: fill;
                }
            }
        }
    }
}
@media (min-width:900px){
    .sec-1-descriptor{

        .sec-main-desc-cont{

            .desc-cont{

                h2{
                    font-size: 35px;

                }

            }
        }
    }
}
@media (min-width:1200px){
    .sec-1-descriptor{
        .sec-main-desc-cont{
            .desc-cont{
                h2{
                    font-size: 47px;
                }
            }
        }
    }
}
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay } from "swiper/modules";

    import "swiper/css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";

    console.log("javascript working");

     let swiper = new Swiper(".mySwiper", {
        modules: [Autoplay],
        loop: true,
        autoplay: {
        delay: 2500,       
        disableOnInteraction: false
        },
     });
</script>
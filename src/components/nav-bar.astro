---
import HamburguerSVG from "../assets/svgs/hamburger.svg"
import CloseMenu from "../assets/svgs/close-menu.svg"
const currentPath = Astro.url.pathname
---
<nav id="navigation-bar">
    <div class="nav-main-container page-width">
        <div class="logo-container">
            <p class="marsh-logo"><a href="/">Marsh Market</a></p>
        </div>

        <button class="hamburguer-button">
            <HamburguerSVG class="hamburguer-svg"></HamburguerSVG>
            <CloseMenu class="close-menu-svg"></CloseMenu> 
        </button>

        <div class="navigation-container">
            <a href="/team" class={currentPath.startsWith('/team') ? 'active' : ''}>Team</a>
            <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a>
        </div>
        
        <div class="fade-screen"></div>
    </div>
</nav>

<style>
.navigation-container a.active {
color: black;
}
nav{
    width: 100%;

    .nav-main-container{
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        .logo-container{
            transition: scale 0.3s;
            .marsh-logo{
                margin:0;
                font-size: var(--desktop-logo-size);
                font-family: var(--desktop-logo-font);
                font-weight:bold;
                a{
                    all:unset;
                }
            }
        }
        .logo-container:hover{
            cursor:pointer;            
            scale: 1.07;
        }
        .hamburguer-button{
            all:unset;
            position: relative;
            width: 23px;
            height: 33px;
            .hamburguer-svg{
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                opacity: 1;
                transition: opacity 0.4s ease;
            }
            .hamburguer-svg.hidden{
                opacity:0;
            }
            .close-menu-svg{
                height: 33px;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
            
        }

        .navigation-container{
            display: flex;
            gap:30px;
            padding:30px;
            height: 100vh;
            width: 55vw;
            z-index: 10;
            flex-direction: column;
            align-items: end;
            background-color: white;
            position: absolute;
            top:70px;
            right: 0;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
            a{
                all:unset;
                font-weight: 500;
                font-size:18px;
                color: #999999;
                transition: color 0.3s, scale 0.3s;
            }
            a:hover{
                cursor:pointer;
                scale: 1.07;
                color: black;
            }

        }
        .navigation-container.show{
            opacity: 1;
            pointer-events: all;
        }
        .fade-screen{
            top: 70px;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 6;
            position: absolute;
            background-color: rgba(26, 26, 26, 0.404);
            display: flex;
            opacity: 0;
            display: none;
            transition: opacity 0.3s;
        }
        .fade-screen.show{
            opacity: 1;
            display: block;
        }
    }
}

@media (min-width:768px){
    nav{
        .nav-main-container{
            padding: 30px 45px;
            .hamburguer-button{
                display: none;
            }
            .navigation-container{
                pointer-events: all;
                height: fit-content;
                width: fit-content;
                padding: 0;
                display: flex;
                position: static;
                flex-direction: row;
                opacity: 1;
            }
        }
    }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const navigationBar = document.querySelector("#navigation-bar");
  const hamburgerButton = navigationBar?.querySelector(".hamburguer-button");
  const hamburguerSVG = navigationBar?.querySelector(".hamburguer-svg");
  const closeMenuSVG = navigationBar?.querySelector(".close-menu-svg");
  const navContainer = navigationBar?.querySelector(".navigation-container");
  const fadeScreen = navigationBar?.querySelector(".fade-screen");
  


  hamburgerButton?.addEventListener("click", () => {
    navContainer?.classList.toggle("show");
    fadeScreen?.classList.toggle("show");
    hamburguerSVG?.classList.toggle("hidden");
  });
});

    
</script>
---
const currentPath = Astro.url.pathname
---
<nav id="navigation-bar">
    <div class="nav-wrapper">
        <div class="nav-main-container page-width">
            <div class="logo-container">
                <p class="marsh-logo"><a href="/">Marsh Market</a></p>
            </div>
    
            <button class="hamburguer-button">
                <div class="hamburguer-svg">
                    <span class="hamburguer-line line-1"></span>
                    <span class="hamburguer-line line-2"></span>
                    <span class="hamburguer-line line-3"></span>
                </div>
            </button>
    
            <div class="navigation-container">
                <a href="/team" class={currentPath.startsWith('/team') ? 'active' : ''}>Team</a>
                <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a>
            </div>
            
            <div class="fade-screen"></div>
        </div>
    </div>
</nav>

<style>
.navigation-container a.active {
color: black;
}
nav{
    width: 100%;
    .nav-wrapper{
        max-width: 1750px;
        margin-inline: auto;
    }
    .nav-main-container{
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        .logo-container{
            transition: scale 0.3s;
            .marsh-logo{
                margin:0;
                font-size: var(--desktop-logo-size);
                font-family: var(--desktop-logo-font);
                font-weight:bold;
                a{
                    all:unset;
                }
            }
        }
        .logo-container:hover{
            cursor:pointer;            
            scale: 1.07;
        }
        .hamburguer-button{
            all:unset;
            position: relative;
            width: 23px;
            height: 20px;
            .hamburguer-svg{
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                .hamburguer-line{
                    width: 100%;
                    height: 2px;
                    background-color: black;
                    border-radius: 2px;
                    transform-origin: center;
                }
            }           
        }

        .navigation-container{
            display: flex;
            gap:30px;
            padding:30px;
            height: 100vh;
            width: 55vw;
            z-index: 10;
            flex-direction: column;
            align-items: end;
            background-color: white;
            position: absolute;
            top:70px;
            right: 0;
            transition: opacity 0.3s;
            opacity: 0;
            a{
                all:unset;
                font-weight: 500;
                font-size:18px;
                color: #999999;
                transition: color 0.3s, scale 0.3s;
            }
            a:hover{
                cursor:pointer;
                scale: 1.07;
                color: black;
            }

        }
        .fade-screen{
            top: 70px;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 6;
            position: absolute;
            pointer-events: none;
            background-color: rgba(26, 26, 26, 0.404);
            display: flex;
            opacity: 0;
        }
    }
}

@media (width > 768px){

    nav{
        .nav-main-container{
            padding: 30px 45px;
            .hamburguer-button{
                display: none;
            }
            .navigation-container{
                pointer-events: all;
                height: fit-content;
                width: fit-content;
                padding: 0;
                display: flex;
                position: static;
                flex-direction: row;
                opacity: 1;
            }
        }
    }
}
@media (width > 900px){
    nav{
        .nav-main-container{
            padding: 30px 65px;
        }
    }
}
</style>

<script>
import { gsap } from "gsap";
const tl = gsap.timeline()

    
document.addEventListener("DOMContentLoaded", () => {

  let menuOpen = false;
  

  const navigationBar = document.querySelector("#navigation-bar");
  const hamburgerButton = navigationBar?.querySelector(".hamburguer-button");
  const hamburguerline1 = navigationBar?.querySelector(".line-1");
  const hamburguerline2 = navigationBar?.querySelector(".line-2");
  const hamburguerline3 = navigationBar?.querySelector(".line-3");
  const hamburguerSVG = navigationBar?.querySelector(".hamburguer-svg");
  const navContainer = navigationBar?.querySelector(".navigation-container");
  const fadeScreen = navigationBar?.querySelector(".fade-screen");
  const isMobile = window.matchMedia("(max-width: 768px)").matches;

    if (isMobile) {
        gsap.set(navContainer, { xPercent: 100 });
    }
  
  
    hamburgerButton?.addEventListener("click", () => {
        if (!menuOpen) {
                menuOpen = true;
                gsap.to(hamburguerline1, { y: 9, rotate: 45, duration: 0.3 });
                gsap.to(hamburguerline2, { opacity: 0, duration: 0.2 });
                gsap.to(hamburguerline3, { y: -9, rotate: -45, duration: 0.3 });
                tl.to(navContainer, {opacity:1, duration:0.05});
                tl.to(navContainer, {xPercent:0, opacity:1}, ">");
                tl.to(fadeScreen, {opacity:1, duration:0.2}, "-=0.4");
                
            } else {
                menuOpen = false;
                gsap.to(hamburguerline1, { y: 0, rotate: 0, duration: 0.3 });
                gsap.to(hamburguerline2, { opacity: 1, duration: 0.3, delay: 0.1 });
                gsap.to(hamburguerline3, { y: 0, rotate: 0, duration: 0.3 });
                tl.to(navContainer, {xPercent:100});
                tl.to(fadeScreen, {opacity:0, duration:0.2}, "-=0.3");
            }
        });
    });

    
</script>
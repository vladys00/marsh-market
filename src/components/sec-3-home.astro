---
 import texture1 from "../assets/images/texture-offer-1.png"
 import texture2 from "../assets/images/texture-offer-2.png"
 import {Image} from "astro:assets"
---

<section class="sec-3-home ">
    <div class="inner-cont ">
        <div class="title-cont">
            <div class="upper-container">
                <h2>
                    Two focused ways we help <br class="desktop-br">
                    brand-first businesses move forward — with clarity, character, and impact.
                </h2>
                <a href="/contact" class="contact-button">Let's talk</a>
            </div>
            <p class="offerings-into">Our Signature Offers are designed to work independently —and even more powerfully together.</p>
        </div>

        <div class="offerings-container">
            <div class="offering off-1">
                <div class="offering-texture">
                    <Image
                        src={texture1}
                        alt="Description of image"
                    />
                </div>
                <h3>Brand-led Shopify Launch / Makeover</h3>
                <p>Design and engineer a distinctive, high-performing Shopify ecosystem—fully customized to your brand identity and built to delight, engage, and scale.</p>
            </div>
            <div class="offering off-2">
                <div class="offering-texture">
                    <Image
                        src={texture2}
                        alt="Description of image"
                    />
                </div>
                <h3>Brand-to-cart creative</h3>
                <p>Channel your brand essence into a high-impact creative campaign —activated across your Shopify experience to convert attention into action and foster advocacy.</p>
            </div>
        </div>
    </div>
</section>

<style>
.sec-3-home{
    .inner-cont{
        padding: 30px 20px;
        .title-cont{
            margin-bottom: 40px;
            h2{
                font-size: 35px;
                .desktop-br{
                    display: none;
                }
            }
            .contact-button{
                display: block;
                width: fit-content;
                margin:20px 0; 
            }
            .offerings-into{
                font-weight: 600;
            }
        }
    }
    .offerings-container{
        border-top:1px solid black;
        padding-top:40px;
        .offering{
            .offering-texture{
                width: 35px;
                height: 35px;
                img{
                    border-radius: 50%;
                    width: 100%;
                    height: 100%;
                }
            }
            h3{
                margin:30px 0 20px 0 ;
            }
        }
        .off-2{
            margin-top:30px;
        }
    }
}

@media (min-width:768px){
    .sec-3-home{
        .inner-cont{
            padding: 50px 45px 100px 45px;
            display: flex;
            .title-cont{
                margin-bottom: 20px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                h2{
                    .desktop-br{
                        display: block;
                    }
                    margin-right: 30px;
                }
                .contact-button{
                    display: block;
                    width: fit-content;
                    margin:20px 0; 
                }
                .offerings-into{
                    font-weight: 600;
                    margin-right: 30px;
                }
            }
            .offerings-container{
                border-left: 1px solid black;
                border-top: none;
                padding:0;
                .offering{
                    padding: 20px;
                    .offering-texture{
                        width: 45px;
                        height: 45px;  
                    }
                    h3{
                        margin:20px 0 15px 0 ;
                    }
                }
                .off-2{
                    margin-top:30px;
                    border-top: 1px solid black;
                }
            }
        }
    }
}

@media (min-width:1200px){
    .sec-3-home{
        .inner-cont{
            .title-cont{
                h2{
                    font-size: 47px;
                    line-height: 1.3;
                }
            }
        }
    }
}
</style>